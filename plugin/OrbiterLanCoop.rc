// The dialog of the "OLC" item in Launchpad (launchpad_item.cpp).
#include <windows.h>
#include "resource.h"

IDD_OLC DIALOGEX 0, 0, 260, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OLC - LAN co-op"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Role:", -1, 10, 12, 60, 8
    COMBOBOX        IDC_OLC_ROLE, 75, 10, 80, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Host address:", -1, 10, 30, 60, 8
    EDITTEXT        IDC_OLC_ADDRESS, 75, 28, 100, 12, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 185, 30, 20, 8
    EDITTEXT        IDC_OLC_PORT, 205, 28, 45, 12, ES_NUMBER
    LTEXT           "Player name:", -1, 10, 48, 60, 8
    EDITTEXT        IDC_OLC_PLAYER, 75, 46, 100, 12, ES_AUTOHSCROLL
    LTEXT           "Host: start any scenario, the others connect to it.\nClient: press Connect to get the host's world and start it.",
                    -1, 10, 66, 240, 18
    LTEXT           "", IDC_OLC_STATUS, 10, 90, 240, 26, SS_NOPREFIX
    PUSHBUTTON      "Connect", IDC_OLC_CONNECT, 140, 126, 55, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 200, 126, 50, 14
END
